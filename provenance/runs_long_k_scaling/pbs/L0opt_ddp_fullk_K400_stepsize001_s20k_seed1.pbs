#!/bin/bash
#PBS -A lc-mpi
#PBS -l select=2:system=polaris
#PBS -l walltime=36:00:00
#PBS -l filesystems=home:eagle
#PBS -q preemptable
#PBS -N L0optddpfullkK4
#PBS -j oe
#PBS -o /eagle/lc-mpi/Zhiqing/polaris_ebm/runs_long_k_scaling/logs/L0opt_ddp_fullk_K400_stepsize001_s20k_seed1.pbs.out

set -euo pipefail
export PROJECT_DIR=/lus/eagle/projects/lc-mpi/Zhiqing/polaris_ebm
export GROUP=long_k_scaling
export EXP_ID=L0opt_ddp_fullk_K400_stepsize001_s20k_seed1
export STORY='original CIFAR EBM long-K scaling; no DRL backbone and no ImageNet-32'
export TRAIN_MODE=ddp_fullk
export WORLD_SIZE=8
export PIPE_STAGES=1
export K=400
export STEPS=20000
export LR=1e-4
export STEP_SIZE=0.01
export WEIGHT_MODE=deep_only
export LAST2_BETA=0.01
export SEED=1
export NUM_NODES=2
export PPN=4
export EVAL_IMAGES=5000
export NOTES='same-step-size smoke only; do not run long horizon without explicit approval'
export RUN_DIR=/eagle/lc-mpi/Zhiqing/polaris_ebm/runs_long_k_scaling/runs/L0_optional_same_step/L0opt_ddp_fullk_K400_stepsize001_s20k_seed1
export MANIFEST_ROW_PATH=/eagle/lc-mpi/Zhiqing/polaris_ebm/runs_long_k_scaling/configs/L0opt_ddp_fullk_K400_stepsize001_s20k_seed1.manifest_row.json
export SAVE_EVERY=5000
export VIS_EVERY=5000
export BATCH_SIZE=64
export NOISE_STD=0.01
export LANGEVIN_SIGN=1.0
export WEIGHT_DECAY=0.0
export MAX_GRAD_NORM=0.0
export DATA_DIR=/eagle/lc-mpi/Zhiqing/ebm/data/cifar10
export CONFIG=/eagle/lc-mpi/Zhiqing/polaris_ebm/runs_long_k_scaling/configs/L0opt_ddp_fullk_K400_stepsize001_s20k_seed1.yaml
export SYNC_FRESH_INIT=1
export DEBUG_LEVEL=1
export LOG_EVERY=10
cp /eagle/lc-mpi/Zhiqing/polaris_ebm/runs_long_k_scaling/configs/L0opt_ddp_fullk_K400_stepsize001_s20k_seed1.yaml /eagle/lc-mpi/Zhiqing/polaris_ebm/runs_long_k_scaling/runs/L0_optional_same_step/L0opt_ddp_fullk_K400_stepsize001_s20k_seed1/experiment_config.yaml
exec /usr/bin/bash /lus/eagle/projects/lc-mpi/Zhiqing/polaris_ebm/scripts/current/pbs_run_ablation_case.pbs
