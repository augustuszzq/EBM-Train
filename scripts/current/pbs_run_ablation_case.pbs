#!/bin/bash
#PBS -A lc-mpi
#PBS -l select=1:system=polaris
#PBS -l walltime=04:00:00
#PBS -l filesystems=home:eagle
#PBS -q preemptable
#PBS -N ablation_train
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${PROJECT_DIR:-}" ]]; then
  PROJECT_DIR="$(cd "${PROJECT_DIR}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -f "${PBS_O_WORKDIR}/scripts/current/ebm_train_sync_mode_a.py" ]]; then
  PROJECT_DIR="${PBS_O_WORKDIR}"
else
  PROJECT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
fi
cd "${PROJECT_DIR}"

module use /soft/modulefiles
module load conda
conda activate /home/kevienzzq/.conda/envs/llm-env

export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

PY=/home/kevienzzq/.conda/envs/llm-env/bin/python
TORCHRUN=/home/kevienzzq/.conda/envs/llm-env/bin/torchrun

GROUP="${GROUP:?GROUP is required}"
EXP_ID="${EXP_ID:?EXP_ID is required}"
STORY="${STORY:-}"
TRAIN_MODE="${TRAIN_MODE:?TRAIN_MODE is required}"
WORLD_SIZE="${WORLD_SIZE:-1}"
PIPE_STAGES="${PIPE_STAGES:-0}"
K="${K:-100}"
STEPS="${STEPS:-20000}"
LR="${LR:-1e-4}"
STEP_SIZE="${STEP_SIZE:-1.0}"
WEIGHT_MODE="${WEIGHT_MODE:-uniform}"
LAST2_BETA="${LAST2_BETA:-0.01}"
SEED="${SEED:-1}"
NUM_NODES="${NUM_NODES:-1}"
PPN="${PPN:-1}"
EVAL_IMAGES="${EVAL_IMAGES:-5000}"
NOTES="${NOTES:-}"
RUN_DIR="${RUN_DIR:?RUN_DIR is required}"
MANIFEST_ROW_PATH="${MANIFEST_ROW_PATH:?MANIFEST_ROW_PATH is required}"
SAVE_EVERY="${SAVE_EVERY:-5000}"
VIS_EVERY="${VIS_EVERY:-1000}"
BATCH_SIZE="${BATCH_SIZE:-64}"
SIGMA_PD="${SIGMA_PD:-0.03}"
NOISE_STD="${NOISE_STD:-0.01}"
LANGEVIN_SIGN="${LANGEVIN_SIGN:-1.0}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.0}"
MAX_GRAD_NORM="${MAX_GRAD_NORM:-0.0}"
DATA_DIR="${DATA_DIR:-/eagle/lc-mpi/Zhiqing/ebm/data/cifar10}"
CONFIG="${CONFIG:-}"
SYNC_FRESH_INIT="${SYNC_FRESH_INIT:-1}"
DEBUG_LEVEL="${DEBUG_LEVEL:-1}"
LOG_EVERY="${LOG_EVERY:-10}"
DRY_RUN="${DRY_RUN:-0}"
RESUME_CKPT="${RESUME_CKPT:-}"

mkdir -p "${RUN_DIR}" "${RUN_DIR}/checkpoints" "${RUN_DIR}/vis"
cp "${MANIFEST_ROW_PATH}" "${RUN_DIR}/manifest_row.json"

TRAIN_LOG="${RUN_DIR}/train.log"
CONFIG_JSON="${RUN_DIR}/config_resolved.json"
JOB_INFO_JSON="${RUN_DIR}/job_info.json"
ATTEMPT_TIMING_JSONL="${RUN_DIR}/attempt_timing.jsonl"

export PROJECT_DIR GROUP EXP_ID STORY TRAIN_MODE WORLD_SIZE PIPE_STAGES K STEPS LR STEP_SIZE
export WEIGHT_MODE LAST2_BETA SEED NUM_NODES PPN EVAL_IMAGES NOTES RUN_DIR MANIFEST_ROW_PATH
export SAVE_EVERY VIS_EVERY BATCH_SIZE SIGMA_PD NOISE_STD LANGEVIN_SIGN WEIGHT_DECAY MAX_GRAD_NORM
export DATA_DIR SYNC_FRESH_INIT DEBUG_LEVEL LOG_EVERY DRY_RUN RESUME_CKPT CONFIG CONFIG_JSON JOB_INFO_JSON
export ATTEMPT_TIMING_JSONL

python3 - <<PY
import json, os
payload = {
    "group": os.environ["GROUP"],
    "exp_id": os.environ["EXP_ID"],
    "story": os.environ.get("STORY", ""),
    "train_mode": os.environ["TRAIN_MODE"],
    "world_size": int(os.environ["WORLD_SIZE"]),
    "pipe_stages": int(os.environ["PIPE_STAGES"]),
    "K": int(os.environ["K"]),
    "steps": int(os.environ["STEPS"]),
    "lr": float(os.environ["LR"]),
    "step_size": float(os.environ["STEP_SIZE"]),
    "weight_mode": os.environ["WEIGHT_MODE"],
    "last2_beta": float(os.environ["LAST2_BETA"]),
    "seed": int(os.environ["SEED"]),
    "num_nodes": int(os.environ["NUM_NODES"]),
    "ppn": int(os.environ["PPN"]),
    "eval_images": int(os.environ["EVAL_IMAGES"]),
    "notes": os.environ.get("NOTES", ""),
    "save_every": int(os.environ["SAVE_EVERY"]),
    "vis_every": int(os.environ["VIS_EVERY"]),
    "batch_size": int(os.environ["BATCH_SIZE"]),
    "sigma_pd": float(os.environ["SIGMA_PD"]),
    "noise_std": float(os.environ["NOISE_STD"]),
    "langevin_sign": float(os.environ["LANGEVIN_SIGN"]),
    "weight_decay": float(os.environ["WEIGHT_DECAY"]),
    "max_grad_norm": float(os.environ["MAX_GRAD_NORM"]),
    "data_dir": os.environ["DATA_DIR"],
    "config": os.environ.get("CONFIG", ""),
    "sync_fresh_init": bool(int(os.environ["SYNC_FRESH_INIT"])),
    "project_dir": os.environ["PROJECT_DIR"],
    "run_dir": os.environ["RUN_DIR"],
    "resume_ckpt": os.environ.get("RESUME_CKPT", ""),
    "pbs_jobid": os.environ.get("PBS_JOBID", ""),
    "pbs_queue": os.environ.get("PBS_QUEUE", os.environ.get("PBS_O_QUEUE", "")),
}
with open(os.environ["CONFIG_JSON"], "w") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
job = {
    "group": os.environ["GROUP"],
    "exp_id": os.environ["EXP_ID"],
    "train_mode": os.environ["TRAIN_MODE"],
    "train_job_id": os.environ.get("PBS_JOBID", ""),
    "train_status": "pending",
    "run_dir": os.environ["RUN_DIR"],
}
with open(os.environ["JOB_INFO_JSON"], "w") as f:
    json.dump(job, f, indent=2, sort_keys=True)
PY

python3 - <<PY
import json, os, socket, time
path = os.environ["JOB_INFO_JSON"]
with open(path) as f:
    payload = json.load(f)
start_ts = int(time.time())
started_iso = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(start_ts))
payload["train_status"] = "running"
payload["train_started_at_epoch"] = start_ts
payload["train_started_at_iso"] = started_iso
with open(path, "w") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
attempt = {
    "event": "start",
    "group": os.environ["GROUP"],
    "exp_id": os.environ["EXP_ID"],
    "train_mode": os.environ["TRAIN_MODE"],
    "pbs_jobid": os.environ.get("PBS_JOBID", ""),
    "run_dir": os.environ["RUN_DIR"],
    "resume_ckpt": os.environ.get("RESUME_CKPT", ""),
    "world_size": int(os.environ["WORLD_SIZE"]),
    "num_nodes": int(os.environ["NUM_NODES"]),
    "ppn": int(os.environ["PPN"]),
    "started_at_epoch": start_ts,
    "started_at_iso": started_iso,
    "host": socket.gethostname(),
}
with open(os.environ["ATTEMPT_TIMING_JSONL"], "a") as f:
    f.write(json.dumps(attempt, sort_keys=True) + "\n")
PY

echo "[RUN] group=${GROUP} exp_id=${EXP_ID} train_mode=${TRAIN_MODE} run_dir=${RUN_DIR}" | tee -a "${TRAIN_LOG}"
echo "[RUN] world_size=${WORLD_SIZE} pipe_stages=${PIPE_STAGES} K=${K} steps=${STEPS} lr=${LR} step_size=${STEP_SIZE}" | tee -a "${TRAIN_LOG}"

resolve_latest_checkpoint() {
  find "${RUN_DIR}/checkpoints" -maxdepth 1 -type f -name 'ckpt_step*.pt' 2>/dev/null \
    | sed -E 's#.*ckpt_step([0-9]+)\.pt#\1 &#' \
    | sort -n \
    | tail -n 1 \
    | cut -d' ' -f2-
}

latest_logged_step() {
  local metrics="${RUN_DIR}/metrics_rank0.csv"
  if [[ ! -f "${metrics}" ]]; then
    return 1
  fi
  local last_line
  last_line="$(tail -n 1 "${metrics}" || true)"
  if [[ -z "${last_line}" || "${last_line}" == step,* ]]; then
    return 1
  fi
  printf '%s\n' "${last_line}" | cut -d',' -f1
}

if [[ "${RESUME_CKPT}" == "latest" || "${RESUME_CKPT}" == "auto" ]]; then
  RESUME_CKPT="$(resolve_latest_checkpoint || true)"
  export RESUME_CKPT
  echo "[RESUME] resolved latest checkpoint: ${RESUME_CKPT:-<none>}" | tee -a "${TRAIN_LOG}"
fi

if latest_step="$(latest_logged_step)"; then
  if [[ "${latest_step}" =~ ^[0-9]+$ ]] && (( latest_step >= STEPS - 1 )); then
    export LATEST_STEP_FOR_SKIP="${latest_step}"
    echo "[SKIP] ${EXP_ID} already reached step ${latest_step}/${STEPS}" | tee -a "${TRAIN_LOG}"
    python3 - <<PY
import json, os, time
path = os.environ["JOB_INFO_JSON"]
with open(path) as f:
    payload = json.load(f)
end_ts = int(time.time())
payload["train_finished_at_epoch"] = end_ts
payload["train_finished_at_iso"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(end_ts))
payload["train_walltime_seconds"] = 0
payload["train_status"] = "skipped_already_complete"
payload["latest_logged_step"] = int(os.environ["LATEST_STEP_FOR_SKIP"])
with open(path, "w") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
PY
    exit 0
  fi
fi

run_single_mode() {
  export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
  local mode="$1"
  local cmd=(
    "${PY}" -u "${PROJECT_DIR}/scripts/current/ebm_train_single_pipe_emul.py"
    --train_mode "${mode}"
    --run_dir "${RUN_DIR}"
    --save_dir "${RUN_DIR}/checkpoints"
    --vis_dir "${RUN_DIR}/vis"
    --steps "${STEPS}"
    --save_every "${SAVE_EVERY}"
    --vis_every "${VIS_EVERY}"
    --K "${K}"
    --batch_size "${BATCH_SIZE}"
    --lr "${LR}"
    --weight_decay "${WEIGHT_DECAY}"
    --max_grad_norm "${MAX_GRAD_NORM}"
    --noise_std "${NOISE_STD}"
    --step_size "${STEP_SIZE}"
    --langevin_sign "${LANGEVIN_SIGN}"
    --fresh_init
    --no_clamp_x
    --pos_noise_std "${SIGMA_PD}"
    --no_clamp_pos
    --data_dir "${DATA_DIR}"
    --seed "${SEED}"
    --debug_level "${DEBUG_LEVEL}"
    --log_every "${LOG_EVERY}"
  )
  if [[ "${mode}" == "single_pipe_emul" ]]; then
    cmd+=(
      --pipe_stages "${PIPE_STAGES}"
      --weight_mode "${WEIGHT_MODE}"
      --last2_beta "${LAST2_BETA}"
    )
  fi
  if [[ -n "${RESUME_CKPT}" ]]; then
    cmd+=(--resume_ckpt "${RESUME_CKPT}")
  fi
  if [[ -n "${CONFIG}" ]]; then
    cmd+=(--config "${CONFIG}")
  fi
  printf '[TRAIN CMD] ' | tee -a "${TRAIN_LOG}"
  printf '%q ' "${cmd[@]}" | tee -a "${TRAIN_LOG}"
  printf '\n' | tee -a "${TRAIN_LOG}"
  if [[ "${DRY_RUN}" == "1" ]]; then
    return 0
  fi
  set +e
  "${cmd[@]}" 2>&1 | tee -a "${TRAIN_LOG}"
  local rc=${PIPESTATUS[0]}
  set -e
  return ${rc}
}

run_distributed_mode() {
  local mode="$1"
  local nodes=()
  if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
    mapfile -t nodes < <(sort -u "${PBS_NODEFILE}")
  else
    nodes=("$(hostname)")
  fi
  local nnodes=${#nodes[@]}
  local expected_world=$(( nnodes * PPN ))
  if [[ "${expected_world}" -ne "${WORLD_SIZE}" ]]; then
    echo "[ERROR] WORLD_SIZE=${WORLD_SIZE} but nnodes=${nnodes} and PPN=${PPN} imply ${expected_world}" | tee -a "${TRAIN_LOG}"
    return 2
  fi
  export MASTER_ADDR="${MASTER_ADDR:-${nodes[0]}}"
  local jid_num
  if [[ -n "${PBS_JOBID:-}" ]]; then
    jid_num="${PBS_JOBID%%.*}"
  else
    jid_num="${RANDOM}"
  fi
  export MASTER_PORT="${MASTER_PORT:-$((29500 + (jid_num % 1000)))}"
  echo "[DIST] nodes=${nnodes} ppn=${PPN} world=${WORLD_SIZE} master=${MASTER_ADDR}:${MASTER_PORT}" | tee -a "${TRAIN_LOG}"
  if [[ "${DRY_RUN}" == "1" ]]; then
    return 0
  fi
  local train_args=()
  if [[ "${mode}" == "ddp_fullk" ]]; then
    train_args=(
      --mode ddp_fullk
      --run_dir "${RUN_DIR}"
      --save_dir "${RUN_DIR}/checkpoints"
      --vis_dir "${RUN_DIR}/vis"
      --steps "${STEPS}"
      --save_every "${SAVE_EVERY}"
      --vis_every "${VIS_EVERY}"
      --K "${K}"
      --batch_size "${BATCH_SIZE}"
      --lr "${LR}"
      --weight_decay "${WEIGHT_DECAY}"
      --max_grad_norm "${MAX_GRAD_NORM}"
      --noise_std "${NOISE_STD}"
      --step_size "${STEP_SIZE}"
      --langevin_sign "${LANGEVIN_SIGN}"
      --fresh_init
      --no_clamp_x
      --pos_noise_std "${SIGMA_PD}"
      --no_clamp_pos
      --data_dir "${DATA_DIR}"
      --seed "${SEED}"
      --debug_level "${DEBUG_LEVEL}"
      --log_every "${LOG_EVERY}"
    )
  else
    train_args=(
      --mode pipeline
      --run_dir "${RUN_DIR}"
      --save_dir "${RUN_DIR}/checkpoints"
      --vis_dir "${RUN_DIR}/vis"
      --steps "${STEPS}"
      --save_every "${SAVE_EVERY}"
      --vis_every "${VIS_EVERY}"
      --K "${K}"
      --batch_size "${BATCH_SIZE}"
      --lr "${LR}"
      --weight_decay "${WEIGHT_DECAY}"
      --max_grad_norm "${MAX_GRAD_NORM}"
      --noise_std "${NOISE_STD}"
      --step_size "${STEP_SIZE}"
      --langevin_sign "${LANGEVIN_SIGN}"
      --fresh_init
      --no_clamp_x
      --pos_noise_std "${SIGMA_PD}"
      --no_clamp_pos
      --data_dir "${DATA_DIR}"
      --seed "${SEED}"
      --debug_level "${DEBUG_LEVEL}"
      --log_every "${LOG_EVERY}"
      --pipe_group_scope world
      --pipe_stages "${PIPE_STAGES}"
      --weight_mode "${WEIGHT_MODE}"
      --last2_beta "${LAST2_BETA}"
    )
  fi
  if [[ "${SYNC_FRESH_INIT}" == "1" ]]; then
    train_args+=(--sync_fresh_init)
  fi
  if [[ -n "${RESUME_CKPT}" ]]; then
    train_args+=(--resume_ckpt "${RESUME_CKPT}")
  fi
  if [[ -n "${CONFIG}" ]]; then
    train_args+=(--config "${CONFIG}")
  fi

  set +e
  if [[ "${nnodes}" -eq 1 ]]; then
    local cmd=(
      "${TORCHRUN}" --standalone --nproc_per_node="${WORLD_SIZE}"
      "${PROJECT_DIR}/scripts/current/ebm_train_sync_mode_a.py"
      "${train_args[@]}"
    )
    printf '[TRAIN CMD] ' | tee -a "${TRAIN_LOG}"
    printf '%q ' "${cmd[@]}" | tee -a "${TRAIN_LOG}"
    printf '\n' | tee -a "${TRAIN_LOG}"
    "${cmd[@]}" 2>&1 | tee -a "${TRAIN_LOG}"
  else
    local train_args_str
    printf -v train_args_str '%q ' "${train_args[@]}"
    local launch_cmd="${TORCHRUN} --nnodes=${nnodes} --node_rank=\${NODE_RANK} --nproc_per_node=${PPN} --rdzv_backend=c10d --rdzv_endpoint=${MASTER_ADDR}:${MASTER_PORT} ${PROJECT_DIR}/scripts/current/ebm_train_sync_mode_a.py ${train_args_str}"
    printf '[TRAIN CMD] %s\n' "${launch_cmd}" | tee -a "${TRAIN_LOG}"
    mpiexec -n "${nnodes}" -ppn 1 --hostfile "${PBS_NODEFILE}" bash -lc '
      set -euo pipefail
      module use /soft/modulefiles
      module load conda
      conda activate /home/kevienzzq/.conda/envs/llm-env
      cd "'"${PROJECT_DIR}"'"
      export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
      export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
      export MASTER_ADDR="'"${MASTER_ADDR}"'"
      export MASTER_PORT="'"${MASTER_PORT}"'"
      export NODE_RANK=${PMI_RANK:-${OMPI_COMM_WORLD_RANK:-${PMIX_RANK:-${PALS_RANKID:-0}}}}
      launch_cmd="'"${launch_cmd}"'"
      eval "${launch_cmd}"
    ' 2>&1 | tee -a "${TRAIN_LOG}"
  fi
  local rc=${PIPESTATUS[0]}
  set -e
  return ${rc}
}

train_rc=0
case "${TRAIN_MODE}" in
  single_fullk)
    run_single_mode "single_fullk" || train_rc=$?
    ;;
  single_pipe_emul)
    run_single_mode "single_pipe_emul" || train_rc=$?
    ;;
  ddp_fullk)
    run_distributed_mode "ddp_fullk" || train_rc=$?
    ;;
  pipe_strict)
    run_distributed_mode "pipe_strict" || train_rc=$?
    ;;
  *)
    echo "[ERROR] unsupported TRAIN_MODE=${TRAIN_MODE}" | tee -a "${TRAIN_LOG}"
    train_rc=2
    ;;
esac

export TRAIN_RC="${train_rc}"

python3 - <<PY
import json, os, time
path = os.environ["JOB_INFO_JSON"]
with open(path) as f:
    payload = json.load(f)
end_ts = int(time.time())
start_ts = int(payload.get("train_started_at_epoch", end_ts))
payload["train_finished_at_epoch"] = end_ts
payload["train_finished_at_iso"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(end_ts))
payload["train_walltime_seconds"] = max(0, end_ts - start_ts)
payload["train_status"] = "dry_run" if os.environ.get("DRY_RUN", "0") == "1" else ("succeeded" if int(os.environ["TRAIN_RC"]) == 0 else "failed")
with open(path, "w") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
attempt = {
    "event": "finish",
    "group": os.environ["GROUP"],
    "exp_id": os.environ["EXP_ID"],
    "train_mode": os.environ["TRAIN_MODE"],
    "pbs_jobid": os.environ.get("PBS_JOBID", ""),
    "run_dir": os.environ["RUN_DIR"],
    "resume_ckpt": os.environ.get("RESUME_CKPT", ""),
    "world_size": int(os.environ["WORLD_SIZE"]),
    "num_nodes": int(os.environ["NUM_NODES"]),
    "ppn": int(os.environ["PPN"]),
    "started_at_epoch": start_ts,
    "started_at_iso": payload.get("train_started_at_iso", ""),
    "finished_at_epoch": end_ts,
    "finished_at_iso": payload["train_finished_at_iso"],
    "walltime_seconds": max(0, end_ts - start_ts),
    "gpu_hours": max(0, end_ts - start_ts) * float(os.environ["WORLD_SIZE"]) / 3600.0,
    "train_rc": int(os.environ["TRAIN_RC"]),
    "status": payload["train_status"],
}
with open(os.environ["ATTEMPT_TIMING_JSONL"], "a") as f:
    f.write(json.dumps(attempt, sort_keys=True) + "\n")
PY

if [[ "${train_rc}" -ne 0 ]]; then
  echo "[FAIL] training failed rc=${train_rc}" | tee -a "${TRAIN_LOG}"
  exit "${train_rc}"
fi

echo "[DONE] train job finished run_dir=${RUN_DIR}" | tee -a "${TRAIN_LOG}"
