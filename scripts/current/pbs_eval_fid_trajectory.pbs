#!/bin/bash
#PBS -A lc-mpi
#PBS -l select=1:system=polaris
#PBS -l walltime=12:00:00
#PBS -l filesystems=home:eagle
#PBS -q preemptable
#PBS -N fid_traj
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${PROJECT_DIR:-}" ]]; then
  PROJECT_DIR="$(cd "${PROJECT_DIR}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -f "${PBS_O_WORKDIR}/scripts/current/eval_fid_trajectory.py" ]]; then
  PROJECT_DIR="${PBS_O_WORKDIR}"
else
  PROJECT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
fi
cd "${PROJECT_DIR}"

module use /soft/modulefiles
module load conda
conda activate /home/kevienzzq/.conda/envs/llm-env

export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export EVAL_PYTHON="/home/kevienzzq/.conda/envs/llm-env/bin/python"
export PYTHONPATH="/eagle/lc-mpi/Zhiqing${PYTHONPATH:+:$PYTHONPATH}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

RUN_DIR="${RUN_DIR:?RUN_DIR is required}"
OUT_DIR="${OUT_DIR:?OUT_DIR is required}"
LABEL="${LABEL:-}"
STEP_INTERVAL="${STEP_INTERVAL:-5000}"
EVAL_IMAGES="${EVAL_IMAGES:-5000}"
EVAL_BATCH="${EVAL_BATCH:-256}"
K_EVAL="${K_EVAL:-100}"
STEP_SIZE="${STEP_SIZE:-1.0}"
NOISE_STD="${NOISE_STD:-0.01}"
LANGEVIN_SIGN="${LANGEVIN_SIGN:-1.0}"
EVAL_SEED="${EVAL_SEED:-1}"
DEVICE="${DEVICE:-cuda}"
DATA_DIR="${DATA_DIR:-/eagle/lc-mpi/Zhiqing/ebm/data/cifar10}"
SKIP_EXISTING="${SKIP_EXISTING:-1}"

mkdir -p "${OUT_DIR}"

cmd=(
  "${EVAL_PYTHON}" "${PROJECT_DIR}/scripts/current/eval_fid_trajectory.py"
  --run-dir "${RUN_DIR}"
  --out-dir "${OUT_DIR}"
  --step-interval "${STEP_INTERVAL}"
  --eval-images "${EVAL_IMAGES}"
  --eval-batch "${EVAL_BATCH}"
  --k-eval "${K_EVAL}"
  --step-size "${STEP_SIZE}"
  --noise-std "${NOISE_STD}"
  --langevin-sign "${LANGEVIN_SIGN}"
  --eval-seed "${EVAL_SEED}"
  --device "${DEVICE}"
  --data-dir "${DATA_DIR}"
)

if [[ -n "${LABEL}" ]]; then
  cmd+=(--label "${LABEL}")
fi
if [[ "${SKIP_EXISTING}" == "1" ]]; then
  cmd+=(--skip-existing)
fi

printf '[PBS] %q ' "${cmd[@]}"
printf '\n'
exec "${cmd[@]}"
