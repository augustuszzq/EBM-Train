#!/bin/bash
#PBS -A lc-mpi
#PBS -l select=1:system=polaris
#PBS -l walltime=04:00:00
#PBS -l filesystems=home:eagle
#PBS -q preemptable
#PBS -N im32drl
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${PROJECT_DIR:-}" ]]; then
  PROJECT_DIR="$(cd "${PROJECT_DIR}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -f "${PBS_O_WORKDIR}/scripts/current/ebm_train_imagenet32_drl_sync.py" ]]; then
  PROJECT_DIR="${PBS_O_WORKDIR}"
else
  PROJECT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
fi
cd "${PROJECT_DIR}"

module use /soft/modulefiles
module load conda
conda activate /home/kevienzzq/.conda/envs/llm-env

export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"

PY=/home/kevienzzq/.conda/envs/llm-env/bin/python
TORCHRUN=/home/kevienzzq/.conda/envs/llm-env/bin/torchrun

GROUP="${GROUP:-imagenet32_drl}"
EXP_ID="${EXP_ID:?EXP_ID is required}"
STORY="${STORY:-DRL-style ResNet backbone external validation}"
TRAIN_MODE="${TRAIN_MODE:?TRAIN_MODE is required}"
WORLD_SIZE="${WORLD_SIZE:-4}"
PIPE_STAGES="${PIPE_STAGES:-1}"
K="${K:-100}"
STEPS="${STEPS:-5000}"
LR="${LR:-1e-4}"
LR_WARMUP_STEPS="${LR_WARMUP_STEPS:-0}"
STEP_SIZE="${STEP_SIZE:-0.01}"
SAMPLER_PRIME="${SAMPLER_PRIME:-0.0}"
SAMPLER_TEMPERATURE="${SAMPLER_TEMPERATURE:-1.0}"
ENERGY_LOSS_SCALE="${ENERGY_LOSS_SCALE:-1.0}"
WEIGHT_MODE="${WEIGHT_MODE:-uniform}"
LAST2_BETA="${LAST2_BETA:-0.01}"
SEED="${SEED:-1}"
NUM_NODES="${NUM_NODES:-1}"
PPN="${PPN:-4}"
EVAL_IMAGES="${EVAL_IMAGES:-50000}"
NOTES="${NOTES:-}"
RUN_DIR="${RUN_DIR:?RUN_DIR is required}"
MANIFEST_ROW_PATH="${MANIFEST_ROW_PATH:?MANIFEST_ROW_PATH is required}"
SAVE_EVERY="${SAVE_EVERY:-5000}"
VIS_EVERY="${VIS_EVERY:-5000}"
BATCH_SIZE="${BATCH_SIZE:-128}"
SIGMA_PD="${SIGMA_PD:-0.03}"
NOISE_STD="${NOISE_STD:-0.01}"
LANGEVIN_SIGN="${LANGEVIN_SIGN:-1.0}"
WEIGHT_DECAY="${WEIGHT_DECAY:-1e-4}"
MAX_GRAD_NORM="${MAX_GRAD_NORM:-0.0}"
GRAD_CLIP_NORM="${GRAD_CLIP_NORM:-}"
DIAGNOSTIC_FIRST_STEPS="${DIAGNOSTIC_FIRST_STEPS:-200}"
DIAGNOSTIC_LOG_EVERY="${DIAGNOSTIC_LOG_EVERY:-50}"
CRASH_ABS_ENERGY="${CRASH_ABS_ENERGY:-1000.0}"
CRASH_MAX_ABS_CHAIN_UNCLAMPED="${CRASH_MAX_ABS_CHAIN_UNCLAMPED:-2.5}"
CRASH_GRAD_NORM="${CRASH_GRAD_NORM:-10000.0}"
SOFT_ABS_ENERGY="${SOFT_ABS_ENERGY:-10.0}"
SOFT_GRAD_NORM="${SOFT_GRAD_NORM:-100.0}"
HARD_GRAD_NORM="${HARD_GRAD_NORM:-500.0}"
CLIP_ACTIVE_FRACTION="${CLIP_ACTIVE_FRACTION:-0.25}"
SOFT_GUARD_STOP="${SOFT_GUARD_STOP:-0}"
SKIP_OPTIMIZER_UNTIL_FULL_DIAGONAL="${SKIP_OPTIMIZER_UNTIL_FULL_DIAGONAL:-0}"
DATA_DIR="${DATA_DIR:-/eagle/lc-mpi/Zhiqing/polaris_ebm/data/imagenet32}"
CONFIG="${CONFIG:?CONFIG is required}"
SYNC_FRESH_INIT="${SYNC_FRESH_INIT:-1}"
DEBUG_LEVEL="${DEBUG_LEVEL:-1}"
LOG_EVERY="${LOG_EVERY:-50}"
DRY_RUN="${DRY_RUN:-0}"
RESUME_CKPT="${RESUME_CKPT:-}"

mkdir -p "${RUN_DIR}" "${RUN_DIR}/checkpoints" "${RUN_DIR}/vis"
cp "${MANIFEST_ROW_PATH}" "${RUN_DIR}/manifest_row.json"

TRAIN_LOG="${RUN_DIR}/train.log"
CONFIG_JSON="${RUN_DIR}/config_resolved.json"
JOB_INFO_JSON="${RUN_DIR}/job_info.json"

export PROJECT_DIR GROUP EXP_ID STORY TRAIN_MODE WORLD_SIZE PIPE_STAGES K STEPS LR LR_WARMUP_STEPS STEP_SIZE
export SAMPLER_PRIME SAMPLER_TEMPERATURE ENERGY_LOSS_SCALE
export WEIGHT_MODE LAST2_BETA SEED NUM_NODES PPN EVAL_IMAGES NOTES RUN_DIR MANIFEST_ROW_PATH
export SAVE_EVERY VIS_EVERY BATCH_SIZE SIGMA_PD NOISE_STD LANGEVIN_SIGN WEIGHT_DECAY MAX_GRAD_NORM
export GRAD_CLIP_NORM DIAGNOSTIC_FIRST_STEPS DIAGNOSTIC_LOG_EVERY CRASH_ABS_ENERGY
export CRASH_MAX_ABS_CHAIN_UNCLAMPED CRASH_GRAD_NORM SOFT_ABS_ENERGY SOFT_GRAD_NORM
export HARD_GRAD_NORM CLIP_ACTIVE_FRACTION SOFT_GUARD_STOP SKIP_OPTIMIZER_UNTIL_FULL_DIAGONAL
export DATA_DIR SYNC_FRESH_INIT DEBUG_LEVEL LOG_EVERY DRY_RUN RESUME_CKPT CONFIG CONFIG_JSON JOB_INFO_JSON

"${PY}" - <<'PY'
import json, os, time
payload = {
    "group": os.environ["GROUP"],
    "exp_id": os.environ["EXP_ID"],
    "story": os.environ.get("STORY", ""),
    "train_mode": os.environ["TRAIN_MODE"],
    "world_size": int(os.environ["WORLD_SIZE"]),
    "pipe_stages": int(os.environ["PIPE_STAGES"]),
    "K": int(os.environ["K"]),
    "steps": int(os.environ["STEPS"]),
    "lr": float(os.environ["LR"]),
    "lr_warmup_steps": int(os.environ["LR_WARMUP_STEPS"]),
    "step_size": float(os.environ["STEP_SIZE"]),
    "sampler_prime": float(os.environ["SAMPLER_PRIME"]),
    "sampler_temperature": float(os.environ["SAMPLER_TEMPERATURE"]),
    "energy_loss_scale": float(os.environ["ENERGY_LOSS_SCALE"]),
    "weight_mode": os.environ["WEIGHT_MODE"],
    "last2_beta": float(os.environ["LAST2_BETA"]),
    "seed": int(os.environ["SEED"]),
    "num_nodes": int(os.environ["NUM_NODES"]),
    "ppn": int(os.environ["PPN"]),
    "eval_images": int(os.environ["EVAL_IMAGES"]),
    "save_every": int(os.environ["SAVE_EVERY"]),
    "vis_every": int(os.environ["VIS_EVERY"]),
    "batch_size": int(os.environ["BATCH_SIZE"]),
    "sigma_pd": float(os.environ["SIGMA_PD"]),
    "noise_std": float(os.environ["NOISE_STD"]),
    "langevin_sign": float(os.environ["LANGEVIN_SIGN"]),
    "weight_decay": float(os.environ["WEIGHT_DECAY"]),
    "max_grad_norm": float(os.environ["MAX_GRAD_NORM"]),
    "grad_clip_norm": (float(os.environ["GRAD_CLIP_NORM"]) if os.environ.get("GRAD_CLIP_NORM", "") else None),
    "diagnostic_first_steps": int(os.environ["DIAGNOSTIC_FIRST_STEPS"]),
    "diagnostic_log_every": int(os.environ["DIAGNOSTIC_LOG_EVERY"]),
    "crash_abs_energy": float(os.environ["CRASH_ABS_ENERGY"]),
    "crash_max_abs_chain_unclamped": float(os.environ["CRASH_MAX_ABS_CHAIN_UNCLAMPED"]),
    "crash_grad_norm": float(os.environ["CRASH_GRAD_NORM"]),
    "soft_abs_energy": float(os.environ["SOFT_ABS_ENERGY"]),
    "soft_grad_norm": float(os.environ["SOFT_GRAD_NORM"]),
    "hard_grad_norm": float(os.environ["HARD_GRAD_NORM"]),
    "clip_active_fraction": float(os.environ["CLIP_ACTIVE_FRACTION"]),
    "soft_guard_stop": bool(int(os.environ["SOFT_GUARD_STOP"])),
    "skip_optimizer_until_full_diagonal": bool(int(os.environ["SKIP_OPTIMIZER_UNTIL_FULL_DIAGONAL"])),
    "clamp_x": True,
    "data_dir": os.environ["DATA_DIR"],
    "config": os.environ["CONFIG"],
    "project_dir": os.environ["PROJECT_DIR"],
    "run_dir": os.environ["RUN_DIR"],
    "resume_ckpt": os.environ.get("RESUME_CKPT", ""),
    "model_family": "drl_resnet_energy",
    "objective": "existing_completion_aware_negative_energy",
    "drl_objective_used": False,
    "pbs_jobid": os.environ.get("PBS_JOBID", ""),
}
with open(os.environ["CONFIG_JSON"], "w") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
job = {
    "group": os.environ["GROUP"],
    "exp_id": os.environ["EXP_ID"],
    "train_mode": os.environ["TRAIN_MODE"],
    "train_job_id": os.environ.get("PBS_JOBID", ""),
    "train_status": "running",
    "run_dir": os.environ["RUN_DIR"],
    "train_started_at_epoch": int(time.time()),
    "train_started_at_iso": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
}
with open(os.environ["JOB_INFO_JSON"], "w") as f:
    json.dump(job, f, indent=2, sort_keys=True)
PY

echo "[RUN] exp_id=${EXP_ID} train_mode=${TRAIN_MODE} run_dir=${RUN_DIR}" | tee -a "${TRAIN_LOG}"
echo "[RUN] DRL backbone only; no recovery likelihood objective or diffusion training" | tee -a "${TRAIN_LOG}"
echo "[RUN] world_size=${WORLD_SIZE} pipe_stages=${PIPE_STAGES} K=${K} steps=${STEPS}" | tee -a "${TRAIN_LOG}"

build_common_args() {
  COMMON_ARGS=(
    --run_dir "${RUN_DIR}"
    --save_dir "${RUN_DIR}/checkpoints"
    --vis_dir "${RUN_DIR}/vis"
    --steps "${STEPS}"
    --save_every "${SAVE_EVERY}"
    --vis_every "${VIS_EVERY}"
    --K "${K}"
    --batch_size "${BATCH_SIZE}"
    --lr "${LR}"
    --lr_warmup_steps "${LR_WARMUP_STEPS}"
    --weight_decay "${WEIGHT_DECAY}"
    --max_grad_norm "${MAX_GRAD_NORM}"
	    --noise_std "${NOISE_STD}"
	    --step_size "${STEP_SIZE}"
	    --sampler_prime "${SAMPLER_PRIME}"
	    --sampler_temperature "${SAMPLER_TEMPERATURE}"
	    --energy_loss_scale "${ENERGY_LOSS_SCALE}"
	    --langevin_sign "${LANGEVIN_SIGN}"
	    --fresh_init
	    --pos_noise_std "${SIGMA_PD}"
	    --no_clamp_pos
	    --data_dir "${DATA_DIR}"
	    --config "${CONFIG}"
	    --seed "${SEED}"
	    --debug_level "${DEBUG_LEVEL}"
	    --log_every "${LOG_EVERY}"
	    --diagnostic_first_steps "${DIAGNOSTIC_FIRST_STEPS}"
	    --diagnostic_log_every "${DIAGNOSTIC_LOG_EVERY}"
	    --crash_abs_energy "${CRASH_ABS_ENERGY}"
	    --crash_max_abs_chain_unclamped "${CRASH_MAX_ABS_CHAIN_UNCLAMPED}"
	    --crash_grad_norm "${CRASH_GRAD_NORM}"
	    --soft_abs_energy "${SOFT_ABS_ENERGY}"
	    --soft_grad_norm "${SOFT_GRAD_NORM}"
	    --hard_grad_norm "${HARD_GRAD_NORM}"
	    --clip_active_fraction "${CLIP_ACTIVE_FRACTION}"
	  )
	  if [[ -n "${GRAD_CLIP_NORM}" ]]; then
	    COMMON_ARGS+=(--grad_clip_norm "${GRAD_CLIP_NORM}")
	  fi
	  if [[ "${SKIP_OPTIMIZER_UNTIL_FULL_DIAGONAL}" == "1" ]]; then
	    COMMON_ARGS+=(--skip_optimizer_until_full_diagonal)
	  fi
	  if [[ "${SOFT_GUARD_STOP}" == "1" || "${SOFT_GUARD_STOP}" == "true" ]]; then
	    COMMON_ARGS+=(--soft_guard_stop)
	  fi
  if [[ -n "${RESUME_CKPT}" ]]; then
    COMMON_ARGS+=(--resume_ckpt "${RESUME_CKPT}")
  fi
}

run_single_mode() {
  export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
  local mode="$1"
  build_common_args
  local cmd=("${PY}" -u "${PROJECT_DIR}/scripts/current/ebm_train_imagenet32_drl_single.py" --train_mode "${mode}" "${COMMON_ARGS[@]}")
  if [[ "${mode}" == "single_pipe_emul" ]]; then
    cmd+=(--pipe_stages "${PIPE_STAGES}" --weight_mode "${WEIGHT_MODE}" --last2_beta "${LAST2_BETA}")
  fi
  printf '[TRAIN CMD] ' | tee -a "${TRAIN_LOG}"
  printf '%q ' "${cmd[@]}" | tee -a "${TRAIN_LOG}"
  printf '\n' | tee -a "${TRAIN_LOG}"
  if [[ "${DRY_RUN}" == "1" ]]; then
    return 0
  fi
  set +e
  "${cmd[@]}" 2>&1 | tee -a "${TRAIN_LOG}"
  local rc=${PIPESTATUS[0]}
  set -e
  return ${rc}
}

run_distributed_mode() {
  local mode="$1"
  local nodes=()
  if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
    mapfile -t nodes < <(sort -u "${PBS_NODEFILE}")
  else
    nodes=("$(hostname)")
  fi
  local nnodes=${#nodes[@]}
  local expected_world=$(( nnodes * PPN ))
  if [[ "${expected_world}" -ne "${WORLD_SIZE}" ]]; then
    echo "[ERROR] WORLD_SIZE=${WORLD_SIZE} but nnodes=${nnodes} and PPN=${PPN} imply ${expected_world}" | tee -a "${TRAIN_LOG}"
    return 2
  fi

  export MASTER_ADDR="${MASTER_ADDR:-${nodes[0]}}"
  local jid_num
  if [[ -n "${PBS_JOBID:-}" ]]; then
    jid_num="${PBS_JOBID%%.*}"
  else
    jid_num="${RANDOM}"
  fi
  export MASTER_PORT="${MASTER_PORT:-$((29500 + (jid_num % 1000)))}"
  echo "[DIST] nodes=${nnodes} ppn=${PPN} world=${WORLD_SIZE} master=${MASTER_ADDR}:${MASTER_PORT}" | tee -a "${TRAIN_LOG}"

  build_common_args
  local train_args=()
  if [[ "${mode}" == "ddp_fullk" ]]; then
    train_args=(--mode ddp_fullk "${COMMON_ARGS[@]}")
  else
    train_args=(
      --mode pipeline
      "${COMMON_ARGS[@]}"
      --pipe_group_scope world
      --pipe_stages "${PIPE_STAGES}"
      --weight_mode "${WEIGHT_MODE}"
      --last2_beta "${LAST2_BETA}"
    )
  fi
  if [[ "${SYNC_FRESH_INIT}" == "1" ]]; then
    train_args+=(--sync_fresh_init)
  fi

  if [[ "${DRY_RUN}" == "1" ]]; then
    printf '[TRAIN CMD] %q ' "${TORCHRUN}" --standalone --nproc_per_node="${WORLD_SIZE}" "${PROJECT_DIR}/scripts/current/ebm_train_imagenet32_drl_sync.py" "${train_args[@]}" | tee -a "${TRAIN_LOG}"
    printf '\n' | tee -a "${TRAIN_LOG}"
    return 0
  fi

  set +e
  if [[ "${nnodes}" -eq 1 ]]; then
    local cmd=("${TORCHRUN}" --standalone --nproc_per_node="${WORLD_SIZE}" "${PROJECT_DIR}/scripts/current/ebm_train_imagenet32_drl_sync.py" "${train_args[@]}")
    printf '[TRAIN CMD] ' | tee -a "${TRAIN_LOG}"
    printf '%q ' "${cmd[@]}" | tee -a "${TRAIN_LOG}"
    printf '\n' | tee -a "${TRAIN_LOG}"
    "${cmd[@]}" 2>&1 | tee -a "${TRAIN_LOG}"
  else
    local train_args_str
    printf -v train_args_str '%q ' "${train_args[@]}"
    local launch_cmd="${TORCHRUN} --nnodes=${nnodes} --node_rank=\${NODE_RANK} --nproc_per_node=${PPN} --rdzv_backend=c10d --rdzv_endpoint=${MASTER_ADDR}:${MASTER_PORT} ${PROJECT_DIR}/scripts/current/ebm_train_imagenet32_drl_sync.py ${train_args_str}"
    printf '[TRAIN CMD] %s\n' "${launch_cmd}" | tee -a "${TRAIN_LOG}"
    mpiexec -n "${nnodes}" -ppn 1 --hostfile "${PBS_NODEFILE}" bash -lc '
      set -euo pipefail
      module use /soft/modulefiles
      module load conda
      conda activate /home/kevienzzq/.conda/envs/llm-env
      cd "'"${PROJECT_DIR}"'"
      export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
      export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
      export MASTER_ADDR="'"${MASTER_ADDR}"'"
      export MASTER_PORT="'"${MASTER_PORT}"'"
      export NODE_RANK=${PMI_RANK:-${OMPI_COMM_WORLD_RANK:-${PMIX_RANK:-${PALS_RANKID:-0}}}}
      launch_cmd="'"${launch_cmd}"'"
      eval "${launch_cmd}"
    ' 2>&1 | tee -a "${TRAIN_LOG}"
  fi
  local rc=${PIPESTATUS[0]}
  set -e
  return ${rc}
}

train_rc=0
case "${TRAIN_MODE}" in
  single_fullk)
    run_single_mode "single_fullk" || train_rc=$?
    ;;
  single_pipe_emul)
    run_single_mode "single_pipe_emul" || train_rc=$?
    ;;
  ddp_fullk)
    run_distributed_mode "ddp_fullk" || train_rc=$?
    ;;
  pipe_strict)
    run_distributed_mode "pipe_strict" || train_rc=$?
    ;;
  *)
    echo "[ERROR] unsupported TRAIN_MODE=${TRAIN_MODE}" | tee -a "${TRAIN_LOG}"
    train_rc=2
    ;;
esac

export TRAIN_RC="${train_rc}"
"${PY}" - <<'PY'
import json, os, time
path = os.environ["JOB_INFO_JSON"]
with open(path) as f:
    payload = json.load(f)
end_ts = int(time.time())
start_ts = int(payload.get("train_started_at_epoch", end_ts))
payload["train_finished_at_epoch"] = end_ts
payload["train_finished_at_iso"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(end_ts))
payload["train_walltime_seconds"] = max(0, end_ts - start_ts)
payload["train_status"] = "dry_run" if os.environ.get("DRY_RUN", "0") == "1" else ("succeeded" if int(os.environ["TRAIN_RC"]) == 0 else "failed")
with open(path, "w") as f:
    json.dump(payload, f, indent=2, sort_keys=True)
PY

if [[ "${train_rc}" -ne 0 ]]; then
  echo "[FAIL] training failed rc=${train_rc}" | tee -a "${TRAIN_LOG}"
  exit "${train_rc}"
fi

echo "[DONE] train job finished run_dir=${RUN_DIR}" | tee -a "${TRAIN_LOG}"
