#!/bin/bash
#PBS -N chqlatex
#PBS -A lc-mpi
#PBS -l select=1:system=polaris
#PBS -l filesystems=home:eagle
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o chqlatex.o${PBS_JOBID}

set -euo pipefail

PROJECT_DIR="${PROJECT_DIR:-/lus/eagle/projects/lc-mpi/Zhiqing/polaris_ebm}"
PY="${PY:-/home/kevienzzq/.conda/envs/llm-env/bin/python}"
DATA_ROOT="${DATA_ROOT:-/eagle/lc-mpi/Zhiqing/polaris_ebm/data/celeba/celeba-lmdb}"
OUT_ROOT="${OUT_ROOT:-/eagle/lc-mpi/Zhiqing/polaris_ebm/data/celeba/celeba-latents/sd-vae-ft-ema-scale018215}"
SPLITS="${SPLITS:-train validation}"
BATCH="${BATCH:-64}"
NUM_WORKERS="${NUM_WORKERS:-4}"
VAE="${VAE:-stabilityai/sd-vae-ft-ema}"
DTYPE="${DTYPE:-fp16}"
ENCODE_MODE="${ENCODE_MODE:-sample}"
SEED="${SEED:-1}"
LIMIT="${LIMIT:-0}"
FORCE="${FORCE:-0}"
LOCAL_FILES_ONLY="${LOCAL_FILES_ONLY:-0}"

cd "${PROJECT_DIR}"
module use /soft/modulefiles
module load conda
conda activate /home/kevienzzq/.conda/envs/llm-env

export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

cmd=(
  "${PY}" -u "${PROJECT_DIR}/scripts/current/export_celebahq256_vae_latents.py"
  --data-root "${DATA_ROOT}"
  --out-root "${OUT_ROOT}"
  --batch "${BATCH}"
  --num-workers "${NUM_WORKERS}"
  --vae "${VAE}"
  --dtype "${DTYPE}"
  --encode-mode "${ENCODE_MODE}"
  --seed "${SEED}"
  --limit "${LIMIT}"
  --device cuda
)
cmd+=(--splits ${SPLITS})
if [[ "${FORCE}" == "1" ]]; then
  cmd+=(--force)
fi
if [[ "${LOCAL_FILES_ONLY}" == "1" ]]; then
  cmd+=(--local-files-only)
fi

printf '[EXPORT CMD] '
printf '%q ' "${cmd[@]}"
printf '\n'
"${cmd[@]}"
