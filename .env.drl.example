# Copy this file to `.env.drl` and edit paths for a new server.
#
# The local helper scripts source `.env.drl` automatically when present.
# `.env.drl` is ignored by git because it is machine-local.

# Absolute path to this checkout. Leave empty to auto-detect from the script.
PROJECT_DIR=

# Materialized ImageNet-32 root. Expected layout:
#   ${DATA_DIR}/train/labels.csv
#   ${DATA_DIR}/train/images/<class>/<image>.png
#   ${DATA_DIR}/val/labels.csv
#   ${DATA_DIR}/val/images/<class>/<image>.png
DATA_DIR=/path/to/imagenet32

# Optional Hugging Face cache used by materialization.
HF_CACHE_DIR=/path/to/hf_cache

# Python/torchrun from the active environment. Usually leave as-is after
# activating the conda env created by `scripts/current/setup_drl_env.sh`.
PYTHON=python
TORCHRUN=torchrun

# GPU visibility and local distributed shape.
CUDA_VISIBLE_DEVICES=0,1,2,3
WORLD_SIZE=4

# Smoke defaults. Increase after the machine/data path is validated.
DRL_TRAIN_MODE=ddp_fullk
DRL_STEPS=2000
DRL_BATCH_SIZE=128
DRL_K=100
DRL_LR=1e-7
DRL_LR_WARMUP_STEPS=10000
DRL_STEP_SIZE=5e-4
DRL_NOISE_STD=5e-4
DRL_GRAD_CLIP_NORM=1.0
DRL_SAMPLER_PRIME=0.0
DRL_SAMPLER_TEMPERATURE=1.0
DRL_ENERGY_LOSS_SCALE=1.0
